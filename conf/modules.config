/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: FASTQC {
        ext.args = '--quiet'
    }

    withName: 'CHOPPER' {
        ext.when = { params.chopper_enabled }
        ext.args2 = {
            [
                params.chopper_trim_approach ? "--trim-approach ${params.chopper_trim_approach}" : '',
                params.chopper_cutoff        ? "--cutoff ${params.chopper_cutoff}"             : '',
                params.chopper_min_quality   ? "-q ${params.chopper_min_quality}"               : '',
                params.chopper_minlength     ? "--minlength ${params.chopper_minlength}"         : '',
                params.chopper_maxlength     ? "--maxlength ${params.chopper_maxlength}"         : '',
            ].findAll { it }.join(' ')
        }
        publishDir = [
            path: { "${params.outdir}/chopper/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: '*.fastq.gz'
        ]
    }

    withName: 'ORIENT_READS' {
        // DEPRECATED: use RESTRANDER instead. Kept for manual/offline runs only.
        publishDir = [
            path: { "${params.outdir}/orient_reads/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: "*.{oriented.fastq.gz,orient_summary.tsv}"
        ]
    }

    withName: 'RESTRANDER' {
        publishDir = [
            path: { "${params.outdir}/restrander/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: "*.{restranded.fastq.gz,stats.json}"
        ]
    }

    withName: 'EXTRACT_BARCODE' {
        publishDir = [
            path: { "${params.outdir}/extract_barcode/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: "*.{bc_tags.tsv.gz,barcode_start.txt}"
        ]
    }

    withName: 'QUIK_STARSOLO' {
        // containerOptions and beforeScript are set via the 'use_gpu' label in base.config
        publishDir = [
            path: { "${params.outdir}/quik_starsolo/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: "*_{R1,R2}_filtered.fastq.gz"
        ]
    }

    withName: 'SPLIT_READS' {
        publishDir = [
            path: { "${params.outdir}/split_reads/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: "*_{R1,R2}.fastq.gz",
            enabled: false   // intermediate files; enable for debugging
        ]
    }

    withName: 'MINIMAP2_INDEX' {
        ext.args = '-I 16G'
        publishDir = [
            path: { "${params.outdir}/genome" },
            mode: params.publish_dir_mode,
            pattern: "*.mmi",
            enabled: params.save_reference ?: false
        ]
    }

    withName: 'MINIMAP2_ALIGN' {
        ext.args = [
            '-ax splice',
            '-uf',
            '--MD',
            '--cap-kalloc 100m',
            '-y',   // copy FASTQ comment fields (UR:Z:/UY:Z: from R2 header) into BAM optional fields
            params.junc_bed ? "--junc-bed ${params.junc_bed}" : ''
        ].join(' ').trim()
        publishDir = [
            path: { "${params.outdir}/minimap2/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: "*.{bam,bai}"
        ]
    }

    withName: 'TAG_BAM' {
        publishDir = [
            path: { "${params.outdir}/tag_bam/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: "*.{tagged.bam,tagged.bam.bai}"
        ]
    }

    //
    // Quantification-mode outputs: published under {outdir}/{gene_quant_mode}/
    // Shared preprocessing above stays at {outdir}/ directly so all modes reuse the same front-end results.
    //

    withName: 'FILTER_PRIMARY_BAM' {
        ext.view_flags = '0x904'
        publishDir = [
            path: { "${params.outdir}/${params.gene_quant_mode}/filter_primary_bam/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: "*.{primary.bam,primary.bam.bai}"
        ]
    }

    withName: 'STRINGTIE_STRINGTIE' {
        ext.args = {
            [
                '-L',
                params.stringtie_mode == 'estimate' ? '-e' : '',
                params.stringtie_opts ?: '',
            ].findAll { it }.join(' ')
        }
        publishDir = [
            path: { "${params.outdir}/${params.gene_quant_mode}/stringtie/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: '*.{transcripts.gtf,gene.abundance.txt,coverage.gtf}'
        ]
    }

    withName: 'GFFREAD' {
        ext.args = '-w'
        publishDir = [
            path: { "${params.outdir}/${params.gene_quant_mode}/transcriptome/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: '*.fasta'
        ]
    }

    withName: 'MINIMAP2_INDEX_TRANSCRIPTOME' {
        ext.args = '-I 2G'
        publishDir = [
            path: { "${params.outdir}/${params.gene_quant_mode}/transcriptome/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: '*.mmi',
            enabled: params.save_reference ?: false
        ]
    }

    withName: 'MINIMAP2_INDEX_TXOME' {
        ext.args = '-I 2G'
        publishDir = [
            path: { "${params.outdir}/${params.gene_quant_mode}/transcriptome/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: '*.mmi',
            enabled: params.save_reference ?: false
        ]
    }

    withName: 'MINIMAP2_ALIGN_TRANSCRIPTOME' {
        ext.args = [
            '-ax map-ont',
            '-y',
            '--MD',
        ].join(' ')
        publishDir = [
            path: { "${params.outdir}/${params.gene_quant_mode}/minimap2_transcriptome/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: "*.{bam,bai}"
        ]
    }

    withName: 'GFFCOMPARE' {
        publishDir = [
            path: { "${params.outdir}/${params.gene_quant_mode}/gffcompare/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: '*.{tmap,refmap,stats,tracking,loci,gtf}'
        ]
    }

    withName: 'SAMTOOLS_FAIDX' {
        publishDir = [
            enabled: false
        ]
    }

    withName: 'SORT_BAM_NAMES' {
        publishDir = [
            path: { "${params.outdir}/${params.gene_quant_mode}/sort_bam_names/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: "*.namesorted.bam",
            enabled: false
        ]
    }

    withName: 'EXTRACT_BAM_TAGS' {
        publishDir = [
            path: { "${params.outdir}/${params.gene_quant_mode}/extract_bam_tags/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: "*.{mapq_tags.tsv.zst,barcode_tags.tsv.zst}"
        ]
    }

    withName: 'ASSIGN_FEATURES' {
        publishDir = [
            path: { "${params.outdir}/${params.gene_quant_mode}/assign_features/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: '*.feature_assigns.tsv.zst'
        ]
    }

    withName: 'CREATE_MATRIX' {
        publishDir = [
            [
                path: { "${params.outdir}/${params.gene_quant_mode}/create_matrix/${meta.id}" },
                mode: params.publish_dir_mode,
                saveAs: { filename ->
                    if (filename.endsWith('versions.yml') || filename.contains('hdf_chunks/')) {
                        return null
                    }
                    if (filename.contains('_gene_bc_matrix')
                        || filename.contains('_transcript_bc_matrix')
                        || filename.endsWith('.matrix_stats.json')
                        || filename.endsWith('.tags.tsv.zst')
                        || filename.endsWith('.sa_tags.tsv.zst')) {
                        return filename
                    }
                    null
                }
            ]
        ]
    }

    withName: 'UMITOOLS_DEDUP' {
        ext.prefix = { "${meta.id}.dedup" }
        ext.args = {
            [
                '--extract-umi-method=tag',
                '--umi-tag=UB',
                '--cell-tag=CB',
                '--per-cell',
                "--method=${params.umitools_dedup_method}",
                params.umitools_dedup_extra_args ?: '',
            ].findAll { it }.join(' ')
        }
        publishDir = [
            path: { "${params.outdir}/${params.gene_quant_mode}/umitools_dedup/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: '*.{bam,log}'
        ]
    }

    withName: 'SAMTOOLS_INDEX' {
        publishDir = [
            enabled: false
        ]
    }

    withName: 'ISOQUANT' {
        ext.args = {
            def stranded_flag = params.strandedness == 'forward' ? '--stranded forward'
                : params.strandedness == 'reverse' ? '--stranded reverse'
                : '--stranded none'
            def gene_quant = params.retain_introns
                ? '--gene_quantification all'
                : '--gene_quantification unique_inconsistent'
            def transcript_quant = params.retain_introns
                ? '--transcript_quantification all'
                : '--transcript_quantification unique_only'
            [
                '--barcoded_bam',
                '--barcode_tag CB',
                '--umi_tag UB',
                '--complete_genedb',
                stranded_flag,
                gene_quant,
                transcript_quant,
                '--splice_correction_strategy default_ont',
                '--model_construction_strategy sensitive_ont',
                '--data_type nanopore',
                '--counts_format mtx',
                params.isoquant_args ?: '',
            ].findAll { it }.join(' ')
        }
        publishDir = [
            path: { "${params.outdir}/${params.gene_quant_mode}/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: '**/*.{tsv,tsv.gz,gtf,bed.gz,log,mtx,mtx.gz}'
        ]
    }

    withName: 'MINIMAP2_ALIGN_TXOME' {
        ext.args = {
            def max_secondary = params.oarfish_save_transcript_secondary_alignment ? 100 : 1
            def secondary = params.oarfish_save_transcript_secondary_alignment ? '--secondary=yes' : '--secondary=no'
            [
                "--MD -ax map-ont --eqx -N ${max_secondary}",
                params.strandedness == 'forward' ? '-uf' :
                params.strandedness == 'reverse' ? '-ub' : '-un',
                secondary,
            ].findAll { it }.join(' ')
        }
        publishDir = [
            path: { "${params.outdir}/${params.gene_quant_mode}/${meta.id}/transcriptome_align" },
            mode: params.publish_dir_mode,
            pattern: '*.{bam,bai}'
        ]
    }

    withName: 'SAMTOOLS_FILTER_MAPPED' {
        ext.view_flags = '4'
        publishDir = [
            path: { "${params.outdir}/${params.gene_quant_mode}/${meta.id}/transcriptome_align" },
            mode: params.publish_dir_mode,
            pattern: '*.{mapped.bam,mapped.bam.bai}'
        ]
    }

    withName: 'SORT_BAM_CB' {
        publishDir = [
            path: { "${params.outdir}/${params.gene_quant_mode}/${meta.id}/cb_sorted" },
            mode: params.publish_dir_mode,
            pattern: '*.bam'
        ]
    }

    withName: 'OARFISH' {
        ext.args = { params.oarfish_args ?: '' }
        publishDir = [
            path: { "${params.outdir}/${params.gene_quant_mode}/${meta.id}/quant" },
            mode: params.publish_dir_mode,
            pattern: '*.{tsv.gz,mtx.gz,json,txt,quant}'
        ]
    }

    withName: 'OARFISH_AGGREGATE' {
        publishDir = [
            [
                path: { "${params.outdir}/${params.gene_quant_mode}/${meta.id}" },
                mode: params.publish_dir_mode,
                saveAs: { filename ->
                    if (filename.endsWith('versions.yml')) {
                        return null
                    }
                    if (filename.contains('_gene_bc_matrix')
                        || filename.contains('_transcript_bc_matrix')
                        || filename.endsWith('.aggregation_stats.json')) {
                        return filename
                    }
                    null
                }
            ]
        ]
    }

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/${params.gene_quant_mode}/multiqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

}
