/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nf-core/starlight Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default config options for all compute environments
----------------------------------------------------------------------------------------
*/

// Global default params, used in configs
params {

    // Paths
    pipeline_cache_dir         = '/scratch/gent/vo/000/gvo00027/tools/panoramaseq_ONT/cache'

    // TODO nf-core: Specify your pipeline's command line flags
    // Input options
    input                      = null

    // Optional subsampling (seqtk sample)
    n_reads                    = null   // integer: number of reads to keep; null = no subsampling

    // Read QC — Chopper (optional quality trim/filter before Restrander)
    chopper_enabled            = false  // set true to enable Chopper quality trimming
    chopper_trim_approach      = 'trim-by-quality'
    chopper_cutoff             = 10     // per-base Q threshold for end trimming
    chopper_min_quality        = 10     // minimum mean read Phred score (-q)
    chopper_minlength          = 100
    chopper_maxlength          = null
    chopper_contaminants       = null   // optional FASTA for contaminant removal (--contam)

    // Read orientation — restrander (mandatory)
    restrander_config          = '/scratch/gent/vo/000/gvo00027/tools/panoramaseq_ONT/pipeline/assets/restrander/PCB109.json'

    // Barcode localization — extract_barcode (parasail)
    rt_adapter                 = 'CTTGCCTGTCGCTCTATCTTCAGAGGAGAGTCCGCCGCCCGCAAG'
    barcode_length             = 36
    barcode_polya_length       = 18
    barcode_window             = 150
    barcode_gap_open           = 2
    barcode_gap_extend         = 4
    barcode_max_anchor_ed      = 5
    barcode_min_qv             = 15
    min_barcode_len            = null   // minimum accepted barcode length; shorter reads are padded with G's; null = strict (must be full barcode_length)

    // Barcode extraction — UMI (5' alignment)
    adapter_anchor             = 'TCTGTTGGTGCTGATATTGCTTT'  // 20 bp constant anchor before UMI
    umi_window                 = 160   // bases from 5' end used for UMI alignment
    max_adapter_ed             = 3     // max edit distance for 5' adapter anchor check

    // Read splitting
    min_cdna_len               = 50    // minimum R2 (cDNA) length to keep a read pair

    // Barcode correction — QUIK
    barcode_whitelist          = null   // path to Spatial Barcode whitelist CSV
    strategy                   = '4_7_mer_gpu_v1'
    distance_measure           = 'SEQUENCE_LEVENSHTEIN'
    rejection_threshold        = null   // defaults to barcode_length * 0.25 in the module
    enable_columba_rescue      = false

    // Alignment — minimap2
    genome_fasta               = null   // reference genome FASTA (required unless genome_mmi given)
    genome_mmi                 = null   // prebuilt minimap2 .mmi index (skips MINIMAP2_INDEX)
    genome_gtf                 = null   // gene annotation GTF (required for StringTie transcriptome assembly)
    junc_bed                   = null   // splice junction BED for --junc-bed (optional)
    save_reference             = false  // publish generated .mmi index to outdir/genome/

    // StringTie — sample transcriptome from primary genome alignments
    stringtie_enabled          = true
    stringtie_mode             = 'assembly'   // 'assembly' or 'estimate' (-e, reference transcripts only)
    stringtie_opts             = '-c 1 -m 50' // extra stringtie flags (ONT; wf-single-cell uses -c 2)
    strandedness               = 'unstranded' // unstranded | forward | reverse

    // Gene assignment — assign_features (transcriptome BAM + gffcompare tmap)
    gene_assign_min_mapq         = 30
    gene_assign_min_tr_coverage  = 0.4
    gene_assign_min_read_coverage = 0.4
    gene_assign_chunksize        = 100000

    // Count matrix — create_matrix (UMI dedup + 10x MEX output)
    matrix_chrom                 = 'all'      // chromosome label written to barcode tags
    matrix_chunk_size            = 200000
    matrix_ref_interval          = 1000
    matrix_umi_length            = null       // if set, filter UMIs to this length
    matrix_skip_umi_clustering   = false

    // Gene quantification mode
    gene_quant_mode              = 'epi2me'   // 'epi2me' | 'isoquant' | 'oarfish'
    retain_introns               = false      // IsoQuant: when true, use --gene/transcript_quantification all
    isoquant_args                = ''         // additional IsoQuant CLI flags (appended after pipeline defaults)
    isoquant_read_group          = 'tag:CB'
    isoquant_use_primary         = true       // filter to primary alignments before UMI-tools dedup
    oarfish_args                 = '--single-cell --model-coverage --filter-group no-filters'
    oarfish_save_transcript_secondary_alignment = true  // false → minimap2 -N 1 on txome FASTQ align
    umitools_dedup_method        = 'directional'
    umitools_dedup_extra_args    = ''           // additional umi_tools dedup CLI flags

    // References (iGenomes)
    genome                     = null
    igenomes_base              = 's3://ngi-igenomes/igenomes/'
    igenomes_ignore            = false

    // MultiQC options
    multiqc_config             = null
    multiqc_title              = null
    multiqc_logo               = null
    max_multiqc_email_size     = '25.MB'
    multiqc_methods_description = null

    // Boilerplate options
    outdir                       = null
    publish_dir_mode             = 'copy'
    // Quantification outputs publish under {outdir}/{gene_quant_mode}/ (see conf/modules.config)
    email                        = null
    email_on_fail                = null
    plaintext_email              = false
    monochrome_logs              = false
    hook_url                     = System.getenv('HOOK_URL')
    help                         = false
    help_full                    = false
    show_hidden                  = false
    version                      = false
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/'
    trace_report_suffix          = new java.util.Date().format( 'yyyy-MM-dd_HH-mm-ss')

    // Config options
    config_profile_name        = null
    config_profile_description = null

    custom_config_version      = 'master'
    custom_config_base         = "https://raw.githubusercontent.com/nf-core/configs/${params.custom_config_version}"
    config_profile_contact     = null
    config_profile_url         = null

    // Schema validation default options
    validate_params            = true
}

// VSC VO-scratch: shared tool cache and per-user work/tmp directories
def voScratchUser = System.getenv('VSC_SCRATCH_VO_USER')
def runUser       = System.getenv('USER') ?: System.getProperty('user.name')

// Shared .sif image store — all users read from / write to the same directory.
// One-time setup: chmod 2775 ${params.pipeline_cache_dir}/singularity/cache
//                 (group-writable so any VO member can add new images)
def sifCacheDir = "${params.pipeline_cache_dir}/singularity/cache"

// Per-user Apptainer OCI pull cache — Apptainer enforces 0700 (owner only).
// This is separate from the .sif store above; it holds transient OCI layer blobs.
def apptainerOciDir = "${params.pipeline_cache_dir}/singularity/oci/${runUser}"

if (voScratchUser) {
    workDir = "${voScratchUser}/work"
}

conda.cacheDir       = "${params.pipeline_cache_dir}/conda"
singularity.cacheDir = sifCacheDir
apptainer.cacheDir   = sifCacheDir

// Load base.config by default for all pipelines
includeConfig 'conf/base.config'

profiles {
    debug {
        dumpHashes              = true
        process.beforeScript    = 'echo $HOSTNAME'
        cleanup                 = false
        nextflow.enable.configProcessNamesValidation = true
    }
    conda {
        conda.enabled           = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        conda.channels          = ['conda-forge', 'bioconda']
        apptainer.enabled       = false
    }
    mamba {
        conda.enabled           = true
        conda.useMamba          = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    docker {
        docker.enabled          = true
        conda.enabled           = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
        docker.runOptions       = '-u $(id -u):$(id -g)'
    }
    arm64 {
        process.arch            = 'arm64'
        // TODO https://github.com/nf-core/modules/issues/6694
        // For now if you're using arm64 you have to use wave for the sake of the maintainers
        // wave profile
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'conda,container'
    }
    emulate_amd64 {
        docker.runOptions       = '-u $(id -u):$(id -g) --platform=linux/amd64'
    }
    singularity {
        singularity.enabled     = true
        singularity.autoMounts  = true
        singularity.ociAutoPull = false  // let Nextflow pull into singularity.cacheDir (BarCall pattern)
        conda.enabled           = false
        docker.enabled          = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    podman {
        podman.enabled          = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    shifter {
        shifter.enabled         = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    charliecloud {
        charliecloud.enabled    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        apptainer.enabled       = false
    }
    apptainer {
        apptainer.enabled       = true
        apptainer.autoMounts    = true
        apptainer.ociAutoPull   = true   // pre-pull oras:// images into apptainer.cacheDir
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
    }
    wave {
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'conda,container'
    }
    gpu {
        docker.runOptions       = '-u $(id -u):$(id -g) --gpus all'
        apptainer.runOptions    = '--nv'
        singularity.runOptions  = '--nv'
    }
    test      { includeConfig 'conf/test.config'      }
    test_full { includeConfig 'conf/test_full.config' }
}

// Load nf-core custom profiles from different institutions

// If params.custom_config_base is set AND either the NXF_OFFLINE environment variable is not set or params.custom_config_base is a local path, the nfcore_custom.config file from the specified base path is included.
// Load nf-core/starlight custom profiles from different institutions.
includeConfig params.custom_config_base && (!System.getenv('NXF_OFFLINE') || !params.custom_config_base.startsWith('http')) ? "${params.custom_config_base}/nfcore_custom.config" : "/dev/null"


// Load nf-core/starlight custom profiles from different institutions.
// TODO nf-core: Optionally, you can add a pipeline-specific nf-core config at https://github.com/nf-core/configs
// includeConfig params.custom_config_base && (!System.getenv('NXF_OFFLINE') || !params.custom_config_base.startsWith('http')) ? "${params.custom_config_base}/pipeline/starlight.config" : "/dev/null"

// Set default registry for Apptainer, Docker, Podman, Charliecloud and Singularity independent of -profile
// Will not be used unless Apptainer / Docker / Podman / Charliecloud / Singularity are enabled
// Set to your registry if you have a mirror of containers
apptainer.registry    = 'quay.io'
docker.registry       = 'quay.io'
podman.registry       = 'quay.io'
singularity.registry  = 'quay.io'
charliecloud.registry = 'quay.io'

// Load igenomes.config if required
includeConfig !params.igenomes_ignore ? 'conf/igenomes.config' : 'conf/igenomes_ignored.config'

// Export these variables to prevent local Python/R libraries from conflicting with those in the container
// The JULIA depot path has been adjusted to a fixed path `/usr/local/share/julia` that needs to be used for packages in the container.
// See https://apeltzer.github.io/post/03-julia-lang-nextflow/ for details on that. Once we have a common agreement on where to keep Julia packages, this is adjustable.

env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
    JULIA_DEPOT_PATH = "/usr/local/share/julia"
    // Conda: shared package cache on scratch (envs still use conda.cacheDir above)
    CONDA_PKGS_DIRS      = "${params.pipeline_cache_dir}/conda/pkgs"
    CONDA_CHANNELS       = "conda-forge,bioconda"
    // Apptainer OCI pull cache: must be per-user (Apptainer enforces 0700).
    // This is NOT the .sif store; it holds transient layer blobs during pulls.
    APPTAINER_CACHEDIR   = apptainerOciDir
    SINGULARITY_CACHEDIR = apptainerOciDir
    APPTAINER_TMPDIR     = voScratchUser ? "${voScratchUser}/tmp" : "${params.pipeline_cache_dir}/tmp"
}

// Set bash options
process.shell = [
    "bash",
    "-C",         // No clobber - prevent output redirection from overwriting files.
    "-e",         // Exit if a tool returns a non-zero status/exit code
    "-u",         // Treat unset variables and parameters as an error
    "-o",         // Returns the status of the last command to exit..
    "pipefail"    //   ..with a non-zero status or zero if all successfully execute
]

// Disable process selector warnings by default. Use debug profile to enable warnings.
nextflow.enable.configProcessNamesValidation = false

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${params.trace_report_suffix}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.html"
}

manifest {
    name            = 'nf-core/starlight'
    contributors    = [
        // TODO nf-core: Update the field with the details of the contributors to your pipeline. New with Nextflow version 24.10.0
        [
            name: 'Poma-Soto Franco',
            affiliation: '',
            email: '',
            github: '',
            contribution: [], // List of contribution types ('author', 'maintainer' or 'contributor')
            orcid: ''
        ],
        [
            name: ' Croughs Quinn',
            affiliation: '',
            email: '',
            github: '',
            contribution: [], // List of contribution types ('author', 'maintainer' or 'contributor')
            orcid: ''
        ],
    ]
    homePage        = 'https://github.com/nf-core/starlight'
    description     = """A pipeline to process long read spatial transcriptomics data """
    mainScript      = 'main.nf'
    defaultBranch   = 'master'
    nextflowVersion = '!>=25.04.0'
    version         = '1.0.0dev'
    doi             = ''
}

// Nextflow plugins
plugins {
    id 'nf-schema@2.5.1' // Validation of pipeline parameters and creation of an input channel from a sample sheet
}

validation {
    defaultIgnoreParams = ["genomes"]
    monochromeLogs = params.monochrome_logs
}

// Load modules.config for DSL2 module specific options
includeConfig 'conf/modules.config'
